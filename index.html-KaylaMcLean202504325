        { id: "p11", name: "P11 · Overnight-eligible lot (designated rows)", overnightEligible: true, distances: [510, 620, 820, 680, 600, 670, 700, 780], report: 0.57, openOffset: 7, occupied: true },
        { id: "p12", name: "P12 · Fairview Street", overnightEligible: true, distances: [460, 570, 790, 630, 550, 620, 670, 740], report: 0.63, openOffset: -9, occupied: true },
        { id: "p13", name: "P13 · Coady International House", overnightEligible: false, distances: [240, 380, 660, 460, 420, 370, 480, 590], report: 0.66, openOffset: 6, occupied: true },
        { id: "p14", name: "P14 · Daytime / general campus lot", overnightEligible: false, distances: [320, 450, 700, 540, 500, 460, 440, 550], report: 0.69, openOffset: -3, occupied: true },
        { id: "p15", name: "P15 · Coady West Wing", overnightEligible: false, distances: [220, 350, 630, 430, 390, 340, 450, 560], report: 0.6, openOffset: 1, occupied: true },
        { id: "p16", name: "P16 · Rollerskate Park", overnightEligible: true, distances: [610, 730, 480, 780, 850, 710, 760, 850], report: 0.51, openOffset: 9, occupied: true },
        { id: "p17", name: "P17 · Oneway / Bishops Place area", overnightEligible: true, distances: [590, 700, 890, 750, 650, 780, 820, 900], report: 0.59, openOffset: -1, occupied: true },
        { id: "p18b", name: "P18b · St. Ninian’s Cathedral", overnightEligible: false, restriction: "Check for funeral or parish-event restrictions before parking.", distances: [820, 910, 680, 1010, 1030, 900, 930, 1050], report: 0.48, openOffset: 5, occupied: true },
        { id: "p18c", name: "P18c · St. Ninian’s Cathedral", overnightEligible: false, restriction: "Check for funeral or parish-event restrictions before parking.", distances: [840, 930, 700, 1030, 1050, 920, 950, 1070], report: 0.46, openOffset: 10, occupied: true }
      ];
      const locationSelect = document.getElementById("location");
      const startInput = document.getElementById("class-start");
      const endInput = document.getElementById("class-end");
      const driveInput = document.getElementById("drive-time");
      const paceInput = document.getElementById("pace");
      const results = document.getElementById("lot-results");
      const summary = document.getElementById("results-summary");
      const trafficEnabled = document.getElementById("traffic-enabled");
      let permit = "day";
      let trafficDurationMinutes = null;
      let hasTrafficEstimate = false;

      const locations = Array.from(locationSelect.options).map((option) => option.value);
      const dayMinutes = 7 * 60;
      const dayEndMinutes = 17 * 60;

      function parseTime(value) {
        if (!/^\d{2}:\d{2}$/.test(value)) return null;
        const [hours, minutes] = value.split(":").map(Number);
        if (hours > 23 || minutes > 59) return null;
        return hours * 60 + minutes;
      }

      function formatTime(totalMinutes) {
        const normalized = ((Math.round(totalMinutes) % 1440) + 1440) % 1440;
        const hours = Math.floor(normalized / 60);
        const minutes = normalized % 60;
        return new Date(2000, 0, 1, hours, minutes).toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
      }

      function formatDuration(minutes) {
        const rounded = Math.max(1, Math.round(minutes));
        if (rounded < 60) return `${rounded} min`;
        const hours = Math.floor(rounded / 60);
        const remainder = rounded % 60;
        return remainder ? `${hours} hr ${remainder} min` : `${hours} hr`;
      }

      function setPermit(value) {
        permit = value;
        document.getElementById("day-permit").setAttribute("aria-pressed", String(value === "day"));
        document.getElementById("night-permit").setAttribute("aria-pressed", String(value === "night"));
        document.getElementById("permit-hint").textContent = value === "day"
          ? "Daytime permit: estimated valid hours 7:00 AM–5:00 PM."
          : "Nighttime permit: estimated valid hours 5:00 PM–7:00 AM; only listed overnight-eligible areas qualify.";
        render();
      }

      function permitCoverage(arrival, classEnd, lot) {
        const day = permit === "day";
        const arrivalMinute = ((arrival % 1440) + 1440) % 1440;
        const dayStart = Math.floor(arrival / 1440) * 1440;
        let allowedUntil;
        let covers;
        if (day) {
          allowedUntil = dayStart + dayEndMinutes;
          covers = arrivalMinute >= dayMinutes && arrivalMinute < dayEndMinutes && classEnd <= allowedUntil;
        } else {
          allowedUntil = arrivalMinute >= dayEndMinutes
            ? dayStart + 1440 + dayMinutes
            : dayStart + dayMinutes;
          covers = lot.overnightEligible &&
            (arrivalMinute >= dayEndMinutes || arrivalMinute < dayMinutes) &&
            classEnd <= allowedUntil;
        }
        return { allowedUntil, covers };
      }

      function nextOpeningWindow(arrival, offset) {
        const target = arrival + offset;
        const hourlyChange = Math.floor(target / 60) * 60 + 50;
        const previousChange = hourlyChange > target ? hourlyChange - 60 : hourlyChange;
        const nextChange = previousChange + 60;
        const change = Math.abs(previousChange - target) <= Math.abs(nextChange - target) ? previousChange : nextChange;
        return `${formatTime(change - 10)}–${formatTime(change + 5)}`;
      }

      function estimatedAvailability(lot, arrival, walkMinutes) {
        const phase = ((arrival % 60) + 60) % 60;
        const nearChange = Math.max(0, 1 - Math.min(Math.abs(phase - 50), 60 - Math.abs(phase - 50)) / 25);
        const walkPenalty = Math.min(0.18, walkMinutes / 180);
        const adjustment = hasTrafficEstimate ? Math.min(0.12, trafficDurationMinutes / 300) : 0;
        return Math.max(8, Math.min(91, Math.round((lot.report * 55 + nearChange * 24 - walkPenalty * 100 - adjustment * 100) * (lot.occupied ? 1 : 1.55))));
      }

      function showError(message) {
        results.innerHTML = `<div class="empty-state" role="alert">${message}</div>`;
      }

      function render() {
        const start = parseTime(startInput.value);
        let end = parseTime(endInput.value);
        if (start === null || end === null) {
          showError("Enter a valid class start and end time to see your parking plan.");
          return;
        }
        if (end <= start) end += 1440;
        const drive = trafficDurationMinutes ?? Number(driveInput.value);
        const paceKmh = Number(paceInput.value);
        if (!Number.isFinite(drive) || drive < 1 || drive > 240) {
          showError("Enter a drive time between 1 and 240 minutes.");
          return;
        }
        const locationIndex = locations.indexOf(locationSelect.value);
        const plans = lots.map((lot) => {
          const walkMinutes = (lot.distances[locationIndex] / 1000) / (paceKmh / 60);
          const arrival = start - walkMinutes;
          const leaveBy = arrival - drive - 5;
          const coverage = permitCoverage(arrival, end, lot);
          const availability = estimatedAvailability(lot, arrival, walkMinutes);
          const orderScore = (coverage.covers ? 100 : 0) + availability - walkMinutes * 0.12;
          return { lot, walkMinutes, arrival, leaveBy, coverage, availability, orderScore };
        }).sort((a, b) => b.orderScore - a.orderScore);
        const hasPermitMatch = plans.some((plan) => plan.coverage.covers);
        summary.textContent = `${locationSelect.value} · Class ${formatTime(start)}–${formatTime(end)} · Estimated drive ${formatDuration(drive)}${hasTrafficEstimate ? " (Google traffic)" : ""}${hasPermitMatch ? "" : " · No lot shown covers the full stay with this permit"}`;
        const bestPlanIndex = plans.findIndex((plan) => plan.coverage.covers);
        const preferredIndex = bestPlanIndex === -1 ? 0 : bestPlanIndex;
        results.innerHTML = plans.map((plan, index) => {
          const { lot, walkMinutes, arrival, leaveBy, coverage, availability } = plan;
          const recommended = index === preferredIndex;
          const recommendationLabel = hasPermitMatch ? "Best fit" : "Closest option";
          const notOvernightEligible = permit === "night" && !lot.overnightEligible;
          const permitLabel = notOvernightEligible
            ? "Not overnight-eligible"
            : coverage.covers ? "Permit covers stay" : "Permit may expire early";
          const badgeClass = coverage.covers ? "badge" : "badge caution";
          const distance = lot.distances[locationIndex];
          const nextDay = coverage.allowedUntil > 1440 || (arrival < 0 && coverage.allowedUntil > 0);
          const allowed = notOvernightEligible
            ? "Not eligible with this permit"
            : nextDay ? formatTime(coverage.allowedUntil) + " next day" : formatTime(coverage.allowedUntil);
          const leave = formatTime(leaveBy);
          const stateNote = lot.occupied
            ? "Walking to class keeps your car here; the spot stays occupied."
            : "You simulated driving out; this space is now counted as available.";
          return `<article class="lot-card ${recommended && coverage.covers ? "recommended" : ""}" role="listitem">
            <div class="lot-top">
              <div><h3 class="lot-name">${lot.name}${recommended ? ` · ${recommendationLabel}` : ""}</h3><p class="lot-distance">Approximate walk: ${distance} m to ${locationSelect.value}</p></div>
              <span class="${badgeClass}">${permitLabel}</span>
            </div>
            <div class="availability">
              <span class="availability-score">${availability}%</span>
              <span class="availability-copy">estimated chance of an open space<br>around your ${formatTime(arrival)} arrival</span>
            </div>
            <div class="lot-facts">
              <div><span class="fact-label">Likely spaces open</span><span class="fact-value">${nextOpeningWindow(arrival, lot.openOffset)}</span></div>
              <div><span class="fact-label">Permit allows you to stay until</span><span class="fact-value">${allowed}</span></div>
              <div><span class="fact-label">Walk to class</span><span class="fact-value">${formatDuration(walkMinutes)}</span></div>
              <div><span class="fact-label">Parking buffer</span><span class="fact-value">5 min</span></div>
              <div class="leave-fact"><span><span class="fact-label">Personalized leave-by time</span><span class="fact-value">${leave}</span></span><span class="fact-label">Drive + parking + walk</span></div>
            </div>
            <p class="lot-note">${stateNote}${lot.restriction ? ` ${lot.restriction}` : ""}${coverage.covers ? "" : notOvernightEligible ? " This area is not marked overnight-eligible in the supplied lot list." : " This permit does not cover the full estimated parking stay, so choose a different permit or check posted rules."}</p>
            <div class="lot-actions">
              <button class="small-button" type="button" data-action="walk" data-lot="${lot.id}">Simulate walking away</button>
              <button class="small-button" type="button" data-action="drive" data-lot="${lot.id}">Simulate driving out</button>
            </div>
          </article>`;
        }).join("");
      }

      document.getElementById("day-permit").addEventListener("click", () => setPermit("day"));
      document.getElementById("night-permit").addEventListener("click", () => setPermit("night"));
      document.getElementById("planner-form").addEventListener("submit", (event) => {
        event.preventDefault();
        render();
      });
      [locationSelect, startInput, endInput, driveInput, paceInput].forEach((input) => {
        input.addEventListener("input", () => {
          if (input === driveInput) {
            trafficDurationMinutes = null;
            hasTrafficEstimate = false;
          }
          if (input === paceInput) {
            document.getElementById("pace-value").textContent = `${Number(input.value).toFixed(1)} km/h`;
            document.getElementById("health-note").textContent = "Manual pace selected.";
          }
          render();
        });
        input.addEventListener("change", render);
      });

      document.getElementById("simulate-health").addEventListener("click", () => {
        paceInput.value = "5.6";
        document.getElementById("pace-value").textContent = "5.6 km/h";
        document.getElementById("health-note").textContent = "Fictional health-app pace loaded: 5.6 km/h. Your trip was recalculated.";
        render();
      });

      results.addEventListener("click", (event) => {
        const button = event.target.closest("button[data-action]");
        if (!button) return;
        const lot = lots.find((item) => item.id === button.dataset.lot);
        if (!lot) return;
        if (button.dataset.action === "walk") {
          lot.occupied = true;
          const note = button.closest(".lot-card").querySelector(".lot-note");
          note.textContent = "You simulated walking to class. Your car remains parked, so the space stays occupied; availability for other drivers is unchanged.";
        } else {
          lot.occupied = false;
          render();
          const card = results.querySelector(`[data-lot="${lot.id}"]`)?.closest(".lot-card");
          if (card) card.querySelector(".lot-note").textContent = "You simulated driving out. The space is now counted as available and the lot estimate has been recalculated for other drivers.";
        }
      });

      trafficEnabled.addEventListener("change", () => {
        document.getElementById("traffic-fields").hidden = !trafficEnabled.checked;
        if (!trafficEnabled.checked) {
          document.getElementById("traffic-result").textContent = "";
          document.getElementById("traffic-result").classList.remove("error");
        }
      });

      document.getElementById("traffic-button").addEventListener("click", async () => {
        const origin = document.getElementById("origin").value.trim();
        const key = document.getElementById("maps-key").value.trim();
        const status = document.getElementById("traffic-result");
        status.classList.remove("error");
        if (!origin || !key) {
          status.textContent = "Enter both a starting address and a Google Maps API key.";
          status.classList.add("error");
          return;
        }
        const start = parseTime(startInput.value);
        if (start === null) {
          status.textContent = "Enter a valid class start time before requesting a route.";
          status.classList.add("error");
          return;
        }
        const button = document.getElementById("traffic-button");
        button.disabled = true;
        button.textContent = "Checking route…";
        status.textContent = "Requesting a traffic-aware estimate from Google Maps…";
        try {
          const departure = new Date();
          const locationIndex = locations.indexOf(locationSelect.value);
          const walkMinutes = (lots[0].distances[locationIndex] / 1000) / (Number(paceInput.value) / 60);
          const minutesUntilLeave = start - (Date.now() - new Date().setHours(0, 0, 0, 0)) / 60000 - walkMinutes - 5;
          departure.setMinutes(departure.getMinutes() + Math.max(0, minutesUntilLeave));
          const response = await fetch("https://routes.googleapis.com/directions/v2:computeRoutes", {
            method: "POST",
            headers: {
              "Content-Type": "application/json",
              "X-Goog-Api-Key": key,
              "X-Goog-FieldMask": "routes.duration"
            },
            body: JSON.stringify({
              origin: { address: origin },
              destination: { address: `${locationSelect.value}, St. Francis Xavier University, Antigonish, NS, Canada` },
              travelMode: "DRIVE",
              routingPreference: "TRAFFIC_AWARE",
              departureTime: departure.toISOString()
            })
          });
          if (!response.ok) {
            const detail = await response.json().catch(() => ({}));
            const reason = detail.error?.message || `Google Maps returned HTTP ${response.status}.`;
            throw new Error(reason);
          }
          const data = await response.json();
          if (!data.routes || !data.routes[0] || !data.routes[0].duration) {
            throw new Error("Google Maps did not return a route. Check the starting address and destination.");
          }
          const seconds = Number.parseInt(data.routes[0].duration, 10);
          if (!Number.isFinite(seconds) || seconds < 1) throw new Error("Google Maps returned an invalid route duration.");
          trafficDurationMinutes = Math.max(1, Math.ceil(seconds / 60));
          hasTrafficEstimate = true;
          driveInput.value = String(trafficDurationMinutes);
          status.textContent = `Traffic-aware drive estimate: ${formatDuration(trafficDurationMinutes)}. Your personalized leave-by times and lot estimates were recalculated.`;
          render();
        } catch (error) {
          status.textContent = `Could not get a traffic estimate: ${error.message}`;
          status.classList.add("error");
        } finally {
          button.disabled = false;
          button.textContent = "Get traffic estimate";
        }
      });

      render();
    })();
  </script>
</body>
</html>
